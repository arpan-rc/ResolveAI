# ANTHROPIC_API_KEY: Optional key for Claude AI processing in ResolveAI.
# If omitted or invalid, ResolveAI automatically uses the deterministic fallback engine.
ANTHROPIC_API_KEY=""

# GEMINI_API_KEY: Optional key for Gemini AI model capabilities.
GEMINI_API_KEY=""

# SUPABASE_URL: Optional Supabase database URL for PostgreSQL backend storage.
# If omitted, ResolveAI automatically uses the high-performance local demo database.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# FORCE_FALLBACK_MODE: Set to "true" to force deterministic rule-based analysis for testing
FORCE_FALLBACK_MODE="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
